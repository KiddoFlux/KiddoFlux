EXPO_PUBLIC_API_URL=

# Firebase service files (kept out of git). Paths are relative to /mobile.
# On EAS, upload them as "file" environment variables and point these at them.
GOOGLE_SERVICES_JSON=./google-services.json
GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist
IOS_BUNDLE_ID=com.kiddoflux.ios

# Firebase JS SDK config, used by the app (works in Expo Go). Firebase Console ->
# Project settings -> General -> Your apps. The values are in google-services.json too
# (api_key.current_key, project_id, storage_bucket, mobilesdk_app_id).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_APP_ID=
