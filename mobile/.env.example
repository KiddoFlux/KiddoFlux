EXPO_PUBLIC_API_URL=

# Firebase service files (kept out of git). Paths are relative to /mobile.
# On EAS, upload them as "file" environment variables and point these at them.
GOOGLE_SERVICES_JSON=./google-services.json
GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist
IOS_BUNDLE_ID=com.kiddoflux.ios

# Google Maps key for Android store and development builds. Expo Go doesn't need it.
# Restrict it to the Android app in Google Cloud. Don't prefix it with EXPO_PUBLIC_.
GOOGLE_MAPS_API_KEY=
