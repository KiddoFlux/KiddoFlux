rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Lunea `saptamana` 00:00 UTC minus 8h = duminica 16:00 UTC = 18:00 ora Romaniei iarna
    // (vara 19:00: o ora in plus fata de PLANNING_DEADLINE_HOUR din aplicatie, niciodata mai putin).
    function termenLimita(saptamana) {
      let p = saptamana.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2])) - duration.value(8, 'h');
    }

    // Tinuta scurta: cu 10 curse, regulile ajung altfel la limita de 1000 de expresii pe cerere.
    // Exact 6 campuri, iar cele 6 sunt accesate mai jos (un camp lipsa = eroare = respins).
    // Campurile text sunt verificate printr-o singura expresie regulata; un tip gresit face ca
    // concatenarea sa esueze, deci cererea e respinsa.
    function esteCursaValida(c, saptamana, maxLocuri) {
      return c.size() == 6
        && (c.data + ' ' + c.zi + ' ' + c.directie + ' ' + c.oraPlecare + ' ' + c.oraSosire).matches(
          '[0-9]{4}-[0-9]{2}-[0-9]{2} (luni|marți|miercuri|joi|vineri) (spreScoala|spreCasa)'
          + ' ([01][0-9]|2[0-3]):[0-5][0-9] ([01][0-9]|2[0-3]):[0-5][0-9]')
        && c.data >= saptamana
        && c.oraPlecare < c.oraSosire
        && c.locuriDisponibile is int && c.locuriDisponibile >= 1 && c.locuriDisponibile <= maxLocuri;
    }

    // Minimum 3 curse, fara maxim: cel mult cele 10 sloturi ale saptamanii (5 zile × 2).
    // Regulile nu au bucle, deci verificam explicit fiecare cursa.
    function suntCurseValide(curse, saptamana, maxLocuri) {
      return curse is list && curse.size() >= 3 && curse.size() <= 10
        && esteCursaValida(curse[0], saptamana, maxLocuri)
        && esteCursaValida(curse[1], saptamana, maxLocuri)
        && esteCursaValida(curse[2], saptamana, maxLocuri)
        && (curse.size() < 4 || esteCursaValida(curse[3], saptamana, maxLocuri))
        && (curse.size() < 5 || esteCursaValida(curse[4], saptamana, maxLocuri))
        && (curse.size() < 6 || esteCursaValida(curse[5], saptamana, maxLocuri))
        && (curse.size() < 7 || esteCursaValida(curse[6], saptamana, maxLocuri))
        && (curse.size() < 8 || esteCursaValida(curse[7], saptamana, maxLocuri))
        && (curse.size() < 9 || esteCursaValida(curse[8], saptamana, maxLocuri))
        && (curse.size() < 10 || esteCursaValida(curse[9], saptamana, maxLocuri));
    }

    function esteDisponibilitateValida(uid, saptamana) {
      let d = request.resource.data;
      let profil = get(/databases/$(database)/documents/parinti/$(uid)).data;
      return saptamana.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.keys().hasOnly(['parinteId', 'saptamana', 'adresaAcasa', 'curse', 'actualizatLa'])
        && d.keys().hasAll(['parinteId', 'saptamana', 'adresaAcasa', 'curse', 'actualizatLa'])
        && d.parinteId == uid
        && d.saptamana == saptamana
        && d.adresaAcasa is string && d.adresaAcasa.size() > 0 && d.adresaAcasa.size() <= 200
        && d.actualizatLa == request.time
        && suntCurseValide(d.curse, saptamana, profil.vehicul.numarLocuri - 1)
        // Doar saptamana urmatoare: intre termenul precedent si termenul acestei saptamani.
        && request.time < termenLimita(saptamana)
        && request.time > termenLimita(saptamana) - duration.value(7, 'd');
    }

    // Un parinte logat isi poate citi DOAR propriul profil.
    // Fara listare, fara scrieri din aplicatie (profilurile se incarca din scriptul de seed).
    match /parinti/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;

      // Disponibilitatea saptamanala: parintele o citeste si o (re)publica doar pe a lui,
      // doar pentru saptamana urmatoare si doar inainte de termenul de duminica.
      match /disponibilitati/{saptamana} {
        allow get: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && esteDisponibilitateValida(uid, saptamana);
        allow list, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
